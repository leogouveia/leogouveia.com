---
import { site } from "../data/site";
const { contact } = site;
---

<section class="mx-auto w-full max-w-[1120px] px-4 pt-[74px] pb-24" id="contato">
  <div class="max-w-[720px]">
    <p class="kicker">{contact.kicker}</p>
    <h2>{contact.heading}</h2>
  </div>
  <div class="grid grid-cols-1 gap-7 text-muted text-lg max-[860px]:grid-cols-1 min-[861px]:grid-cols-2">
    <p>{contact.intro}</p>
    <div class="flex flex-col items-start gap-3.5">
      <a class="contact-link" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="contact-link" href={contact.github}>{contact.githubLabel}</a>
      <a class="contact-link" href={contact.linkedin}>{contact.linkedinLabel}</a>
    </div>
  </div>
</section>
