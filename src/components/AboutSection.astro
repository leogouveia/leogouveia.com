---
import { site } from "../data/site";
const { about } = site;
---

<section class="mx-auto w-full max-w-[1120px] px-4 py-[74px]" id="sobre">
  <div class="max-w-[720px]">
    <p class="kicker">{about.kicker}</p>
    <h2>{about.heading}</h2>
  </div>
  <div class="grid grid-cols-1 gap-7 text-muted text-lg max-[860px]:grid-cols-1 min-[861px]:grid-cols-2">
    {
      about.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }
  </div>
  <ul class="mt-6 flex flex-wrap gap-3 p-0 list-none" aria-label="Competencias">
    {
      about.skills.map((skill) => (
        <li class="tag-item font-bold text-ink">{skill}</li>
      ))
    }
  </ul>
</section>
